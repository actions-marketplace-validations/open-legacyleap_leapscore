{
  "name": "leapscore-scan",
  "version": "1.0.2",
  "description": "Local-first legacy and maintainability scanner: one readable bundle, zero runtime dependencies, scored against a public rubric.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "leapscore-scan": "./bin/leapscore-scan.mjs"
  },
  "files": [
    "bin/leapscore-scan.mjs",
    "dist/leapscore-scan.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-legacyleap/leapscore.git",
    "directory": "apps/scanner"
  },
  "homepage": "https://github.com/open-legacyleap/leapscore#readme",
  "bugs": {
    "url": "https://github.com/open-legacyleap/leapscore/issues"
  },
  "keywords": [
    "legacy-code",
    "maintainability",
    "static-analysis",
    "code-scanning",
    "rubric"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node scripts/build.mjs && tsc --noEmit",
    "build:bundle": "node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "test": "SCANNER_NO_LISTEN=1 vitest run"
  },
  "devDependencies": {
    "@leapscore/contracts": "*",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
