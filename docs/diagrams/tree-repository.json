    {
      "dot": "cyan",
      "title": "Produce / Present Split",
      "items": [
        "apps/scanner produces the envelope and ships one ESM bundle",
        "apps/site only renders; the site boundary check forbids a scan runtime",
        "apps/surface writes issues with a separate token in a separate process"
      ]
    },
    {
      "dot": "emerald",
      "title": "Generated vs Canonical",
      "items": [
        "docs/rubric/indicators is hand-authored",
        "apps/scanner/src/scan/scoring/rubric.json, apps/site/lib/generated/rubric.ts, and docs/rubric/sheets are generated",
        "tooling/lib/rubric-catalog.ts derives categories from the directory tree"
      ]
    }
