  "cards": [
    {
      "dot": "cyan",
      "title": "Document, Not Database",
      "items": [
        "The real artifact is one JSON envelope; these entities are the stable shape its fields imply",
        "rowKey and categoryKey are document-local identities (reportId plus the row or category id)",
        "JSON columns keep evidence, status counts, coverage, and source-row lists lossless"
      ]
    },
    {
      "dot": "rose",
      "title": "Comparability",
      "items": [
        "meta carries the contract version and the semantic inputs a differ needs",
        "requested_indicators is absent rather than empty on older envelopes",
        "The delta document is derived and never mutates the sealed envelope"
      ]
    }
  ]
