  "cards": [
    {
      "dot": "cyan",
      "title": "Producer Owns the Shape",
      "items": [
        "packages/contracts is the single definition; consumers import rather than redeclare",
        "Render-only fields stay on the site and never enter the wire shape",
        "Contract version gates ingest: newer envelopes are skipped with a reason"
      ]
    },
    {
      "dot": "rose",
      "title": "Detector Isolation",
      "items": [
        "Detectors receive a read-only context and an abort signal",
        "RawFact forbids score, status, confidence, and verdict keys",
        "Only gh.ts may call fetch; the context carries the injected client"
      ]
    }
  ]
