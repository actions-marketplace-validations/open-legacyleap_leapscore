  "cards": [
    {
      "dot": "cyan",
      "title": "One producer contract",
      "items": [
        "packages/contracts owns the envelope, runId grammar, bands, gates, badges, and funnel copy",
        "Scanner, site, CLI, Action, and surface all import it; no consumer declares a second report shape",
        "The scanner is stateless: the terminal report frame is the only scan artefact"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two execution paths",
      "items": [
        "Remote: site streams scanner NDJSON, which fans out to GitHub API and a shallow clone",
        "Local: CLI and Action scan a checked-out directory and write report.json/html/md",
        "Both paths converge on sealScan for score, gates, coverage, and runId"
      ]
    },
    {
      "dot": "violet",
      "title": "Generated rubric",
      "items": [
        "Canonical indicators live under docs/rubric/indicators",
        "compile-rubric emits rubric.json for scanners and rubric.ts for the site",
        "CI rejects drift instead of letting a hand-edited copy survive"
      ]
    }
  ]
