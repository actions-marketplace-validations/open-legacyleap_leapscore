  "cards": [
    {
      "dot": "cyan",
      "title": "Budget Is the Control Plane",
      "items": [
        "The budget is computed from the requested indicator classes, not from wall-clock guesses",
        "GH detectors and clone detectors share one deadline; a 240s killer fails the run without sealing",
        "A plain expiry seals remaining rows as unknown with a capped disclosure"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two Data Lanes",
      "items": [
        "GitHub API lane: repo metadata, contents, and pull history for six indicators",
        "Clone lane: a blobless shallow clone read through a byte-capped readFile proxy",
        "Archetype and ecosystem sniffing happen between clone and detector fan-out"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest Failure",
      "items": [
        "Admission refusal happens before any GitHub or clone work",
        "A failed clone does not cancel the seal; affected rows become unknown",
        "Exactly one terminal frame is emitted: report, refused, or run-failure"
      ]
    }
  ]
