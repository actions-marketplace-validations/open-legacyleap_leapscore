  "cards": [
    {
      "dot": "cyan",
      "title": "Facts Are Not Scores",
      "items": [
        "Detectors emit raw facts, evidence pointers, provenance, and an optional measurement status",
        "Forbidden keys (score, status, confidence, verdict) are validated out of raw facts",
        "The scorer owns row status, clamping, applicability, and category arithmetic"
      ]
    },
    {
      "dot": "rose",
      "title": "Seal-Time Decisions",
      "items": [
        "Gates can cap the band at High without altering the score",
        "Fewer than half gradeable rows suppresses the headline as insufficient-signal",
        "The fingerprint hashes facts, rubric and engine versions, snapshots, and semantic flags"
      ]
    },
    {
      "dot": "emerald",
      "title": "One Artefact, Many Views",
      "items": [
        "The live site renders the terminal report frame; it never runs a scan",
        "The CLI writes report.json, report.html, and report.md from the same envelope",
        "Surface and the badge derive their output from the sealed envelope only"
      ]
    }
  ]
